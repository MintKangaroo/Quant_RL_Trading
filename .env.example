# =============================================================================
# Quant_RL_Trading — 환경변수 템플릿
# =============================================================================
# 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   cp .env.example .env
# .env 는 .gitignore 에서 차단된다. 실제 키를 이 파일에 적지 말 것.
# =============================================================================

# -----------------------------------------------------------------------------
# LS증권 Open API
# -----------------------------------------------------------------------------
LS_APPKEY=
LS_APPSECRET=

# REST / WebSocket 엔드포인트
LS_REST_BASE_URL=
LS_WS_BASE_URL=

# 계좌 (모의/실전 구분)
LS_ACCOUNT_NO=
LS_ACCOUNT_PRODUCT_CODE=

# -----------------------------------------------------------------------------
# 외부 데이터 소스
# -----------------------------------------------------------------------------
OPENDART_API_KEY=
NEWS_API_KEY=
ECOS_API_KEY=

# KRX 정보데이터시스템 (data.krx.co.kr) — 과거 시세 백필용.
# 2025년부터 로그인이 필요하다. 무료 가입 후 회원 ID/비밀번호를 넣는다.
# 이게 없으면 pykrx 는 예외 없이 빈 결과를 돌려준다 — 조용한 실패다.
KRX_ID=
KRX_PW=

# -----------------------------------------------------------------------------
# Claude API — 리뷰 파이프라인 (M5)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# 저장소
# -----------------------------------------------------------------------------
# Quant_RL_Trading 의 정식 저장소는 Parquet + DuckDB 이며 store.get() 으로만 접근한다.
# 아래는 운영 메타데이터용 선택 항목.
DATABASE_URL=

# -----------------------------------------------------------------------------
# 대시보드 (Flask)
# -----------------------------------------------------------------------------
FLASK_SECRET_KEY=
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=6060

# -----------------------------------------------------------------------------
# 알림
# -----------------------------------------------------------------------------
# 시황 브리핑 메일 (tools/send_briefing.py). 넷 중 하나라도 비면 발송을
# 조용히 건너뛴다 — 리포트는 비필수 경로라 없다고 터지지 않는다.
# SMTP_SENDER_PASSWORD 는 Gmail **앱 비밀번호**다. 2단계 인증이 켜진
# 계정에서만 발급된다. 만료·회수되면 myaccount.google.com/apppasswords 에서
# 새로 만들어 여기만 갈아 끼운다 — 코드 변경은 필요 없다.
SMTP_SERVER=
SMTP_SENDER_EMAIL=
SMTP_SENDER_PASSWORD=
RECIPIENT_EMAIL=
# 선택. 비우면 587(STARTTLS).
SMTP_PORT=

# -----------------------------------------------------------------------------
# 미장 — LS 해외주식
# -----------------------------------------------------------------------------
# **국장과 별도 appkey 를 쓴다.** LS 는 appkey 당 토큰 1개만 유효해서, 같은
# 키를 공유하면 한쪽이 재발급할 때 다른 쪽 토큰이 IGW00121 로 죽는다.
LS_US_APPKEY=
LS_US_APPSECRET=

# -----------------------------------------------------------------------------
# 미장 유니버스 — SEC EDGAR
# -----------------------------------------------------------------------------
# SEC 는 신원 없는 요청을 막는다. "이름 이메일" 형식.
SEC_EDGAR_USER_AGENT=

# -----------------------------------------------------------------------------
# 거시지표
# -----------------------------------------------------------------------------
# FRED (미국) — 발표 일정 + 실측값 + S&P 500
FRED_API_KEY=

# KOSIS (국가통계포털) — 국장 CPI·PPI·실업률·GDP
KOSIS_API_KEY=

# ECOS 는 위쪽에 이미 있다. 국장 기준금리·국고채는 ECOS 에만 있다.
# ⚠️ 무효한 키에 503 HTML 을 HTTP 404 로 돌려준다. 응답이 `<` 로 시작하면
#    서버 장애가 아니라 키를 의심할 것.
